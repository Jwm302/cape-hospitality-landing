# Copy to .env for local development (npm run dev). On Vercel, add these under
# Project → Settings → Environment Variables. See docs/live-hotel-data-setup.md.

# --- Live hotel lookup (Virtual Audit demo) ---
# Google Places API (New): live rating, review count and address. Server-side only.
GOOGLE_PLACES_API_KEY=""

# DataForSEO: the latest 100 Google reviews per hotel. Optional; without it the
# demo shows the Google snapshot only.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Gemini: groups reviews into themes. Optional; without it the review stats
# still show, just without themes.
GEMINI_API_KEY=""

# Optional: which review source to use (default: dataforseo).
# REVIEW_SOURCE="dataforseo"

# Optional: Upstash Redis (Vercel KV integration) to reuse a hotel's analysis
# for 30 days and enforce a daily cap. Vercel sets these automatically when
# the integration is connected.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# MAX_REVIEW_LOOKUPS_PER_DAY="200"

# --- Forms ---
# Web3Forms access key that delivers the inquiry and briefing forms to
# contact@capehospitalityadvisors.com. Public by design.
VITE_WEB3FORMS_KEY=""
